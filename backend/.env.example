APP_NAME=Castelei
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# É daqui que sai o endereço das imagens e vídeos enviados pelo painel
# (APP_URL + /storage/...). Em dev precisa da porta do `php artisan serve`,
# senão o endereço sai sem ela e a imagem não carrega. No Railway, é o
# domínio público do backend.
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Painel de conteúdo (ver docs/painel-admin.md) ---
# Quem administra o conteúdo em /admin, separado por vírgula. É a porta de
# entrada: sem ela não haveria como criar o primeiro administrador no Railway,
# onde dá para criar variável pelo navegador mas rodar comando exige CLI.
# Depois do primeiro acesso, o caminho normal é `php artisan castelei:admin`.
# ADMIN_EMAILS=voce@exemplo.com

# Onde ficam as imagens e vídeos enviados pelo painel.
# ATENÇÃO no Railway: o disco do contêiner é descartado a cada deploy. Sem um
# volume montado em /app/storage/app/public, tudo que for enviado some no
# deploy seguinte. Para armazenamento externo, use s3 e preencha as AWS_* abaixo.
# MEDIA_DISK=public
# MEDIA_MAX_IMAGE_KB=4096
# MEDIA_MAX_VIDEO_KB=51200

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
