# URL da API Laravel. Usada só no servidor do Next: o navegador nunca fala direto com ela.
# Local:
API_URL=http://localhost:8000/api
# Railway: use o domínio público do serviço do backend, terminando em /api
# API_URL=https://SEU-BACKEND.up.railway.app/api

# Modo de teste: sem tela de login. Cada navegador recebe uma conta de visitante automaticamente.
# Remova (ou deixe diferente de "true") para voltar ao login normal.
# GUEST_MODE=true

# Endereço público do site, sem barra no fim. Usado no sitemap, no robots.txt
# e nas prévias de link (WhatsApp, Google). Sem ele, vale o domínio da Railway.
# SITE_URL=https://castelei.com.br

# E-mail de suporte que aparece na Política de Privacidade (/privacidade).
# Sem ele, a página manda usar o contato da ficha na Google Play.
# CONTACT_EMAIL=contato@exemplo.com

# --- Google Play (ver docs/play-store.md) ---
# Impressão digital SHA-256 do certificado com que o Google assina o app.
# Sai em Play Console → Integridade do app → Assinatura de app.
# Sem ela, /.well-known/assetlinks.json responde 404 de propósito.
# Aceita várias separadas por vírgula (útil para testar o APK local junto).
# ANDROID_CERT_FINGERPRINTS=AB:CD:EF:...
# ANDROID_PACKAGE_NAME=br.com.castelei.app
